    %% ============================================================
    %% FLUJO COMPLETO PAW FRIEND — Actualizado 2026-04-13
    %% Alineado con CLAUDE.md §7 rutas, §6 edge functions (21 activas).
    %% Refleja navegacion real post-optimizacion:
    %%   BottomTabBar: Inicio | Mascotas | Vets | Recordatorios | Perfil
    %%   Sidebar: Salud (+ Rutinas + Calendario) | Descubrir | Comunidad (+ Profesional si aplica)
    %%   Chat salio de BottomTabBar: se accede desde Header y Sidebar
    %%   ActiveRoleProvider permite dual-role switching (dueno <-> vet)
    %% Regla: este archivo es UN SOLO bloque pegable en mermaid.live
    %% y se actualiza en el MISMO commit que cualquier cambio de flujo.
    %% Ver CLAUDE.md §9.7.1
    %% ============================================================

    %% ============ ENTRY POINTS ============
    subgraph ENTRY["ENTRADA"]
        direction TB
        LAND["pawfriend.cl Landing"]
        DEEP["Deep link / QR / WhatsApp"]
    end

    LAND --> AUTH_CHECK{"Logueado?"}
    DEEP --> AUTH_CHECK

    AUTH_CHECK -->|Si| HOME
    AUTH_CHECK -->|"No + ruta protegida"| AUTH_PAGE
    AUTH_CHECK -->|"No + ruta publica"| PUB_DIR

    %% ============ PAGINAS PUBLICAS ============
    subgraph PUBLIC["PUBLICAS sin login"]
        direction TB
        PUB_DIR["Directorio vets /veterinarios"]
        PUB_PROF["Perfil vet /veterinarios/:slug"]
        PUB_PRICE["Estimador precios /precios-veterinarios"]
        PUB_B2B["Landing B2B /para-veterinarios"]
        PUB_REG["Registro vet /registro-veterinario"]
        PUB_RESENA["Dejar resena /resena/:token"]
        PUB_QR["QR Landing /qr/:token"]
        PUB_PAWCARD["Paw Card Landing /paw-card/:id"]
    end

    PUB_PAWCARD -->|Logueado| PAWCARD_COLLECT["Coleccionar carta"]
    PUB_PAWCARD -->|No logueado| AUTH_PAGE

    PUB_DIR --> PUB_PROF
    PUB_B2B --> PUB_REG

    %% ============ AUTH + POST-LOGIN ============
    subgraph AUTH_PAGE["AUTH /auth"]
        direction TB
        AUTH_M["Email | Google | Facebook"]
        AUTH_M --> AUTH_SUPA["Supabase Auth"]
    end

    AUTH_SUPA --> FIRST{"Primera vez?"}
    FIRST -->|"Dueno nuevo"| ONB_D["Onboarding mascota 3 pasos: mascota + salud + ubicacion"]
    FIRST -->|"Vet nuevo"| ONB_V["Onboarding vet 3 pasos: perfil + clinica + como funciona"]
    FIRST -->|"Ya tiene cuenta"| REDIR{"Redirect"}
    REDIR -->|"returnTo"| REDIR_DEST["Pagina solicitada"]
    REDIR -->|Proveedor| VET_DASH
    REDIR -->|Con mascotas| HOME
    REDIR -->|Sin mascotas| ONB_D
    ONB_D --> HOME
    ONB_V --> VET_DASH
    PUB_REG --> VET_DASH

    %% ============ HOME DASHBOARD ============
    HOME["HOME /home"]
    HOME --> H_ONBOARD{"Primera visita?"}
    H_ONBOARD -->|Si| H_TUTORIAL["Tutorial carousel 4 slides"]
    H_ONBOARD -->|No| H_CONTENT

    H_TUTORIAL --> H_CONTENT["Contenido Home"]
    H_CONTENT --> H_HINTS{"Sin mascotas?"}
    H_HINTS -->|Si| H_CARDS["3 tarjetas guia: mascota, recordatorio, vet"]
    H_HINTS -->|No| H_MAIN["Home completo"]

    H_MAIN --> H_PETS["Pet switcher avatares"]
    H_MAIN --> H_STATUS["Status cards: cita, vacunas, ficha, racha"]
    H_MAIN --> H_ALERTS["Alertas salud: vencidos + proximos"]
    H_MAIN --> H_ROUTINES["Widget rutinas de hoy"]
    H_MAIN --> H_PRICE["Estimador precios"]
    H_MAIN --> H_WEEKLY["Reporte semanal"]
    H_MAIN --> H_REVIEWS["Resenas pendientes"]
    H_MAIN --> H_QUICK["Acciones rapidas: vet, ficha, precios, mapa"]
    H_MAIN --> H_GAME["PawGame widget"]
    H_MAIN --> H_INTEGRATIONS["Card integraciones: WhatsApp + GCal"]
    H_MAIN --> H_FEED["Feed comunidad"]

    %% ============ TAB MASCOTAS ============
    subgraph MASCOTAS["MASCOTAS /my-pets"]
        direction TB
        PET_LIST["Lista mascotas (Paw Cards TCG)"]
        PET_ADD["Agregar /add-pet"]
        PET_EDIT["Editar /edit-pet/:id"]
        PET_FLIP["Flip carta → QR reverso"]
        PET_COLLECTION["Paw Collection /paw-collection"]
        PET_LIST --> PET_ADD
        PET_LIST --> PET_EDIT
        PET_LIST --> PET_FLIP
        PET_LIST --> PET_COLLECTION
    end

    PET_FLIP --> PUB_PAWCARD

    PET_ADD --> PLAN_CHK{"Limite plan?"}
    PLAN_CHK -->|"Gratis max 2"| UPGRADE
    PLAN_CHK -->|OK| PET_FORM["Formulario mascota"]
    PET_FORM --> OCR_CHK{"Sube carnet?"}
    OCR_CHK -->|Si| OCR_FN["edge fn ocr-vaccination-card (IA)"]
    OCR_CHK -->|No| PET_SAVE
    OCR_FN --> PET_SAVE["Guarda mascota"]
    PET_SAVE --> HOLO_REVEAL["Holo Reveal: asigna patron holografico + Paw Card ID"]
    HOLO_REVEAL --> PET_TRIGGERS["Trigger: recordatorios + PawPoints"]
    PET_LIST --> FC_RES

    %% ============ FICHA CLINICA ============
    subgraph CLINICAL["FICHA CLINICA /ficha/:petId"]
        direction TB
        FC_RES["Tab Resumen"]
        FC_HIST["Tab Historial 25 tipos"]
        FC_ALIM["Tab Alimentacion"]
        FC_DOCS["Tab Documentos"]
        FC_SHARE["Tab Compartir"]
        FC_PDF["Generar PDF"]
        FC_AI["Asistente IA"]
    end

    FC_HIST --> FC_ADD_REC["Agregar registro medico"]
    FC_DOCS --> FC_UPLOAD["Upload a Storage"]
    FC_SHARE --> FC_QR["QR mascota + descargar"]
    FC_SHARE --> FC_LINK["Link temporal 30 dias"]
    FC_SHARE --> FC_WA["Boton WhatsApp"]

    %% ============ MEDICAL SHARE LANDING (joya de la corona) ============
    FC_LINK --> MED_SHARE["/medical-share/:token"]
    FC_WA --> MED_SHARE
    MED_SHARE --> MED_SHARE_CHK{"Token valido?"}
    MED_SHARE_CHK -->|"Si + vigente"| MED_SHARE_VIEW["Vista publica ficha clinica"]
    MED_SHARE_CHK -->|"Expirado"| MED_SHARE_ERR["Link caducado"]
    MED_SHARE_VIEW --> MED_SHARE_PDF["Descarga PDF"]

    %% ============ ASISTENTE IA ============
    FC_AI --> AI_DISC["Disclaimer medico"]
    AI_DISC --> AI_Q["Pregunta del dueno"]
    AI_Q --> AI_RATE{"Rate limit 5/dia?"}
    AI_RATE -->|OK| AI_PROCESS["Claude Sonnet + datos ficha"]
    AI_RATE -->|Excedido| AI_BLOCK["Limite alcanzado"]
    AI_PROCESS --> AI_URG{"Urgencia?"}
    AI_URG -->|Alta| AI_VET_BANNER["Banner: consultar vet YA"]
    AI_URG -->|"Media/Baja"| AI_SUGG["Sugerencias"]
    AI_VET_BANNER --> VET_DIR

    %% ============ TAB BUSCAR VET ============
    subgraph TAB_VETS_DIR["DIRECTORIO VETS /veterinarios"]
        direction TB
        VET_DIR["Filtros: comuna, especialidad, rating"]
        VET_NEW["Carousel nuevos vets"]
        VET_DIR --> VET_PERF["Perfil vet"]
        VET_NEW --> VET_PERF
    end

    VET_PERF --> VET_AGENDAR["Agendar consulta"]
    VET_PERF --> VET_MENSAJE["Enviar mensaje"]
    VET_PERF --> VET_RESENAS["Ver resenas"]
    VET_PERF --> VET_PRECIOS["Ver precios"]

    %% ============ RESERVAS ============
    VET_AGENDAR --> BK_CAL["Calendario disponibilidad"]
    BK_CAL --> BK_SLOT["Selecciona horario"]
    BK_SLOT --> BK_CONFIRM["Confirma reserva"]
    BK_CONFIRM --> BK_LIST["Mis reservas /mis-reservas"]

    %% ============ TAB RECORDATORIOS ============
    subgraph RECORDATORIOS["RECORDATORIOS /reminders"]
        direction TB
        REM_OVER["Vencidos - badge rojo"]
        REM_TODAY["Hoy/Manana - amarillo"]
        REM_NEXT["Proximos - purple"]
        REM_DONE["Marcar completado"]
    end

    PET_TRIGGERS --> REM_OVER
    REM_DONE --> GCAL_SYNC["Sync Google Calendar"]

    %% ============ RUTINAS SEMANALES ============
    subgraph RUTINAS["RUTINAS /rutinas"]
        direction TB
        RUT_LIST["Lista rutinas activas"]
        RUT_WEEK["Vista semanal L-D"]
        RUT_ADD["Crear rutina"]
        RUT_COMPLETE["Marcar completada"]
        RUT_SKIP["Marcar saltada"]
        RUT_LIST --> RUT_ADD
        RUT_LIST --> RUT_WEEK
        RUT_LIST --> RUT_COMPLETE
        RUT_LIST --> RUT_SKIP
    end

    RUT_COMPLETE --> GCAL_SYNC

    %% ============ CALENDARIO UNIFICADO ============
    subgraph CALENDARIO["CALENDARIO /calendario"]
        direction TB
        CAL_GRID["Grid mensual multi-color"]
        CAL_FILTER["Filtros mascota + tipo"]
        CAL_DAY["Vista dia unificada"]
        CAL_GRID --> CAL_DAY
        CAL_FILTER --> CAL_GRID
    end

    CAL_DAY --> RUT_COMPLETE
    CAL_DAY --> REM_DONE

    %% ============ TAB PERFIL ============
    PROFILE["/profile"] --> SETTINGS["/settings"]
    PROFILE --> USER_PUB["/user/:userId (perfil publico)"]
    SETTINGS --> GROOMER_EDIT["/peluquero/perfil (solo groomers)"]
    SETTINGS --> GCAL_CONNECT["Conectar Google Calendar"]
    GCAL_CONNECT --> GCAL_OAUTH["OAuth Google"]
    GCAL_OAUTH --> GCAL_TOKEN["refresh_token"]
    GCAL_TOKEN --> GCAL_SYNC

    %% ============ SIDEBAR: SALUD ============
    subgraph SIDEBAR_SALUD["SIDEBAR: SALUD"]
        direction TB
        SB_INICIO["Inicio /home"]
        SB_MASCOTAS["Mis mascotas /my-pets"]
        SB_RECORDATORIOS["Recordatorios /reminders"]
        SB_RUTINAS["Rutinas /rutinas"]
        SB_CALENDARIO["Calendario /calendario"]
    end

    SB_INICIO --> HOME
    SB_MASCOTAS --> PET_LIST
    SB_RECORDATORIOS --> REM_OVER
    SB_RUTINAS --> RUT_LIST
    SB_CALENDARIO --> CAL_GRID

    %% ============ SIDEBAR: DESCUBRIR ============
    subgraph DESCUBRIR["SIDEBAR: DESCUBRIR"]
        direction TB
        SB_BUSCAR_VET["Buscar vet /veterinarios"]
        SVC["Servicios /servicios"]
        SVC --> SVC_TYPES["Paseadores | Cuidadores | Entrenadores | Peluqueros"]
        MAPA["Mapa multi-capa /maps"]
        MAPA --> MAPA_TABS["Perdidas | Adopcion | Servicios | Tiendas | Pet Friendly"]
    end

    SB_BUSCAR_VET --> VET_DIR
    SVC --> VET_DIR

    %% ============ SIDEBAR: COMUNIDAD ============
    %% Nota: Chat salio de la BottomTabBar. Se accede desde Header
    %% y desde este grupo del sidebar.
    subgraph COMUNIDAD["SIDEBAR: COMUNIDAD"]
        direction TB
        FEED_SB["Feed /feed"]
        COMMUNITY_PAGE["Comunidad /comunidad"]
        COMMUNITY_SLUG["Comunidad /comunidad/:slug"]
        CHAT_PAGE["Chat /chat (Header + Sidebar)"]
        CHAT_PAGE --> CHAT_CONV["/chat/:conversationId realtime"]
        PAWCARDS["Paw Cards /paw-collection"]
        PAWCARDS --> PC_GRID["Grid coleccion"]
        PAWCARDS --> PC_FILTERS["Filtros especie/rareza"]
        PAWCARDS --> PC_STATS["Estadisticas"]
        PAWGAME["Paw Game /paw-game"]
        PAWGAME --> PG_MISSIONS["Misiones activas"]
        PAWGAME --> PG_BADGES["Badges"]
        PAWGAME --> PG_RANK["Rankings mensuales"]
        COMMUNITY_PAGE --> COMMUNITY_SLUG
    end

    FEED_SB --> FEED_LIST
    VET_MENSAJE --> CHAT_PAGE

    %% ============ SOCIAL FEED ============
    subgraph FEED["FEED SOCIAL /feed"]
        direction TB
        FEED_LIST["Posts recientes"]
        FEED_CREATE["Crear post"]
        FEED_INTERACT["Like / Comentar"]
        FEED_USER["Perfil usuario"]
        FEED_USER --> FEED_FOLLOW["Follow / Block / Report"]
    end

    %% ============ PAGOS ============
    subgraph PAGOS["PAGOS PREMIUM"]
        direction TB
        UPGRADE["Upgrade /upgrade"]
        UPGRADE --> PAY_SELECT["Mensual $3.990 | Anual $39.900"]
        PAY_SELECT --> PAY_FLOW["flow-create-subscription"]
        PAY_FLOW --> PAY_REDIRECT["Redirige a Flow.cl"]
        PAY_REDIRECT --> PAY_RESULT{"Resultado"}
        PAY_RESULT -->|Exitoso| PAY_WH["Webhook: is_premium=true"]
        PAY_RESULT -->|Cancela| UPG_CANCEL["/upgrade/cancel"]
        PAY_WH --> PAY_RESULT_PAGE["/payment-result ?status=success"]
        PAY_RESULT_PAGE --> UPG_OK["/upgrade/success"]
        UPG_OK --> PAY_UNLOCK["Desbloquea: ilimitadas + PDF + compartir"]
        UPG_CANCEL --> UPGRADE
    end

    %% ============ AREA VETERINARIO ============
    subgraph VET_AREA["AREA VETERINARIO (Sidebar Profesional)"]
        direction TB
        VET_DASH["Dashboard /provider/dashboard"]
        PRO_DASH["Panel Pro /panel-pro"]
        VET_DASH --> VET_FOLLOW["Seguimientos 7d"]
        VET_DASH --> VET_SHARED["Fichas compartidas"]
        VET_DASH --> VET_STATS["Stats: visitas, rating, clientes"]
        VET_DASH --> VET_BAL["Balance: disponible, pendiente, total"]
        VET_DASH --> VET_PAT["Lista pacientes"]
        VET_DASH --> VET_PROFILE_EDIT["Editar perfil /provider/profile-edit"]
        VET_DASH --> PRO_DASH
        VET_PROFILE_EDIT --> VET_PREVIEW["Ver como me ven los duenos"]
    end

    VET_PAT --> VET_NEW_PAT["Nuevo paciente + invitar dueno"]
    VET_NEW_PAT --> VET_INVITE_FN["edge fn send-pet-invitation"]
    VET_INVITE_FN --> VET_INVITE_EMAIL["Email al dueno con link"]
    VET_PAT --> VET_NOTE["Crear nota clinica"]
    VET_NOTE --> VET_TEMPLATE["Plantilla consulta (consultation_templates)"]
    VET_TEMPLATE --> VET_SAVE_NOTE["Guarda nota"]
    VET_SAVE_NOTE --> VET_TRIG_REV["Trigger: invitacion resena"]
    VET_SAVE_NOTE --> VET_TRIG_REM["Trigger: crea recordatorio"]
    VET_NOTE --> VET_GRIMACE["Grimace Scale (dolor felino)"]

    VET_TRIG_REV --> REV_LINK["Link resena con token"]
    REV_LINK --> REV_FORM["Formulario: estrellas + comentario"]
    REV_FORM --> REV_SAVE["Guarda + actualiza avg_rating"]

    %% ============ QR FLOW ============
    %% El QR impreso apunta a la landing publica /qr/:token (PUB_QR)
    %% y desde ahi se bifurca segun rol del visitante.
    FC_QR --> PUB_QR
    PUB_QR --> QR_SCAN{"Rol visitante?"}
    QR_SCAN -->|"Vet verificado"| QR_VET["Ficha completa + registra relacion"]
    QR_SCAN -->|Dueno| QR_OWN["Su ficha"]
    QR_SCAN -->|Otro| QR_PUB_INFO["Info basica publica"]

    %% ============ OTROS ============
    subgraph OTROS["OTROS FLUJOS (accesibles desde Home/Sidebar)"]
        direction TB
        ADOPTION["Adopcion /adoption (con perfil adoptante)"]
        MEMORIAL["En Memoria /en-memoria"]
        REPORTES["Reportes /reportes"]
        ANALYTICS["Analytics Demo /analytics-demo"]
        BLOOD_BANK["Banco de sangre /donantes-sangre"]
    end

    H_QUICK --> ADOPTION
    H_QUICK --> MEMORIAL
    H_QUICK --> REPORTES
    VET_DASH --> ANALYTICS

    %% Memorial conecta al asistente IA empatico (edge fn)
    MEMORIAL --> BEREAVEMENT_FN["edge fn bereavement-assistant (IA empatica)"]

    %% ============ BACKEND ============
    subgraph BACKEND["BACKEND AUTOMATICO (21 edge functions + cron)"]
        direction TB
        CRON["Cron diario 9AM Chile"]
        CRON --> CRON_REMIND["edge fn reminder-cron"]
        CRON_REMIND --> CRON_EMAIL["Email"]
        CRON_REMIND --> CRON_WA["edge fn send-whatsapp-reminder (pendiente Meta)"]
        CRON --> CRON_WEEKLY_OWNER["edge fn generate-weekly-owner-reports"]
        CRON --> CRON_WEEKLY_VET["edge fn generate-weekly-vet-reports"]
    end

    CRON_WEEKLY_OWNER --> H_WEEKLY
    CRON_WEEKLY_VET --> REPORTES

    %% ============ ADMIN ============
    subgraph ADMIN["ADMIN /admin"]
        direction TB
        ADM["Panel 13 tabs"]
        ADM --> ADM_U["Usuarios"]
        ADM --> ADM_P["Proveedores"]
        ADM --> ADM_V["Verificacion Colmevet"]
        ADM --> ADM_M["Moderacion"]
        ADM --> ADM_MET["Metricas"]
        ADM --> ADM_MIS["Editor misiones"]
    end

    %% ============ SEO ============
    LAND --> SEO_SITEMAP["Sitemap edge function"]
    PUB_DIR --> SEO_HELMET["Helmet meta tags"]
    PUB_PROF --> SEO_HELMET
    PUB_PRICE --> SEO_HELMET

    %% ============ CONEXIONES PRINCIPALES ============
    H_ALERTS --> REM_OVER
    H_QUICK --> VET_DIR
    H_QUICK --> FC_RES
    H_QUICK --> PUB_PRICE
    H_QUICK --> MAPA
    H_GAME --> PAWGAME
    H_ROUTINES --> RUT_LIST
    H_FEED --> FEED_LIST
