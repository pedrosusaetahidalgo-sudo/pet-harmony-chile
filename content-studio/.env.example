# Copiá este archivo a .env y completá los valores.
# Nunca commitear .env (ya está en .gitignore).

# ElevenLabs (voz IA para reels)
# Conseguí tu key en https://elevenlabs.io/app/settings/api-keys
ELEVEN_LABS_API_KEY=

# Voice ID de la voz que querés usar. Buscá en https://elevenlabs.io/app/voice-library
# y copiá el ID (ej: "21m00Tcm4TlvDq8ikWAM"). La voz se elige según idioma,
# genero y estilo. Para español latino recomiendo filtrar por "Spanish" y
# elegir una voz Latin/Mexican/Chilean.
ELEVENLABS_VOICE_ID=

# Modelo. eleven_multilingual_v2 soporta español bien.
# Otros: eleven_turbo_v2_5 (mas rapido y barato), eleven_v3 (mejor calidad).
ELEVENLABS_MODEL=eleven_multilingual_v2

# Pexels Videos (B-roll stock gratuito, licencia comercial OK).
# Registrate gratis en https://www.pexels.com/api/new/
PEXELS_API_KEY=
