# ─── Supabase ───────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# ─── Google OAuth ───────────────────────────────────────
# Web Client ID — obtenido en Google Cloud Console > APIs & Services > Credentials
# Tipo: "Web application" (no "Android" ni "iOS")
VITE_GOOGLE_CLIENT_ID_WEB=__REEMPLAZAR_GOOGLE_WEB_CLIENT_ID__

# ─── Google Maps ────────────────────────────────────────
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-key

# ─── Facebook / Meta ────────────────────────────────────
# Obtenido en Meta for Developers > App Dashboard > Settings > Basic
VITE_FACEBOOK_APP_ID=__REEMPLAZAR_FACEBOOK_APP_ID__
VITE_FACEBOOK_CLIENT_TOKEN=__REEMPLAZAR_FACEBOOK_CLIENT_TOKEN__

# ─── Apple Sign-In ──────────────────────────────────────
# Service ID from Apple Developer > Identifiers (activa el boton de Apple en login)
VITE_APPLE_SERVICE_ID=cl.pawfriend.app

# ─── Firebase Analytics ─────────────────────────────────
# Obtenido en Firebase Console > Project Settings > Web App
VITE_FIREBASE_API_KEY=__REEMPLAZAR_FIREBASE_API_KEY__
VITE_FIREBASE_AUTH_DOMAIN=__REEMPLAZAR__.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=__REEMPLAZAR_FIREBASE_PROJECT_ID__
VITE_FIREBASE_STORAGE_BUCKET=__REEMPLAZAR__.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=__REEMPLAZAR__
VITE_FIREBASE_APP_ID=__REEMPLAZAR_FIREBASE_APP_ID__
VITE_FIREBASE_MEASUREMENT_ID=G-__REEMPLAZAR__

# ─── Meta Pixel (Web only) ─────────────────────────────
VITE_META_PIXEL_ID=__REEMPLAZAR_META_PIXEL_ID__

# ─── Sentry ─────────────────────────────────────────────
VITE_SENTRY_DSN=

# ─── PostHog (opcional) ─────────────────────────────────
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# ─── Environment ────────────────────────────────────────
NODE_ENV=development
APP_NAME=pawfriend

# ─── Marketing / comercial (playbook 2026-04-19) ──────
# Contacto publico canonico (mostrado en /donaciones, PawCompanys, etc).
VITE_CONTACT_EMAIL=pedrosusaeta@pawfriend.cl

# Founding Vet Offer (playbook §9.4). Override estos valores sin tocar
# codigo para cambiar cupos, deadline, precios de la oferta fundadora.
VITE_FOUNDING_VET_SPOTS_TOTAL=10
VITE_FOUNDING_VET_DEADLINE_ISO=2026-05-01T23:59:59-04:00
VITE_FOUNDING_VET_PRICE_CLP=4990
VITE_FOUNDING_VET_PUBLIC_PRICE_CLP=9900

# Donaciones limites (playbook §3). Min/max en CLP.
VITE_DONATION_MIN_CLP=500
VITE_DONATION_MAX_CLP=500000

# ─── Android signing (CI only, NEVER commit real values) ──
ANDROID_KEYSTORE_BASE64=
ANDROID_KEYSTORE_PASSWORD=changeme
ANDROID_KEY_ALIAS=pawfriend
ANDROID_KEY_PASSWORD=changeme

# ─── iOS signing (CI only, NEVER commit real values) ────
IOS_CERTIFICATE_BASE64=
IOS_CERTIFICATE_PASSWORD=
IOS_MOBILEPROVISION_BASE64=
